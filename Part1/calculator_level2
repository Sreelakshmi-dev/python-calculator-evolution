
def calculate(first, second, op):
    match op:
        case 1: return first + second
        case 2: return first - second
        case 3: return first * second
        case 4: return first / second
        case 5: return first // second
        case 6: return first % second
        case _: raise ValueError


try:
    first_number = int(input('Enter first number: '))
    second_number = int(input('Enter second number: '))
    print('1.Addition\n2.Subtraction\n3.Multiplication\n4.Division\n5.Floor Division\n6.Modulo:)')
    choice = int(input('Enter your choice: '))
    result = calculate(first_number, second_number, choice)
    print(result)
except ValueError:
    print('Invalid Input')
except ZeroDivisionError:
    print('Division or Modulo by zero is not possible')

