import tkinter as tk
import calculator_abstract_class as CL
import tkinter_csv


def check_details(object_check):
    if object_check.second_number == '' and object_check.first_number != '':
        object_check.second_number = object_check.first_number
    if object_check.first_number == '' and object_check.second_number != '':
        object_check.first_number = 0
    if object_check.second_number == '' and object_check.first_number == '' \
            and object_check.output == '':
        object_check.first_number = object_check.second_number = 0
    if isinstance(object_check.first_number,str) and '.' not in object_check.first_number:
        object_check.first_number = int(object_check.first_number)
    elif '.' in str(object_check.first_number):
        object_check.first_number = float(object_check.first_number)
    if isinstance(object_check.second_number, str) and '.' not in object_check.second_number:
        object_check.second_number = int(object_check.second_number)
    elif '.' in str(object_check.second_number):
        object_check.second_number = float(object_check.second_number)


def return_equals(return_object, remain=''):
    try:
        if return_object.operator != '':
            check_details(return_object)
            if return_object.operator == '+':
                return_object.output = CL.Addition(return_object.first_number, return_object.second_number).operation()
            elif return_object.operator == '-':
                return_object.output = CL.Subtraction(return_object.first_number, return_object.second_number).operation()
            elif return_object.operator == '*':
                return_object.output = CL.Multiplication(return_object.first_number, return_object.second_number).operation()
            elif return_object.operator == '/':
                return_object.output = CL.Division(return_object.first_number, return_object.second_number).operation()
            elif return_object.operator == '%':
                return_object.output = CL.Modulo(return_object.first_number, return_object.second_number).operation()
            return_object.history.append((return_object.first_number, return_object.operator, return_object.second_number, '=', return_object.output))
            tkinter_csv.csvfile_save(return_object.first_number, return_object.operator, return_object.second_number, return_object.output)
            if remain == 'c':
                return_object.first_number = return_object.output
            else:
                return_object.enter_value.set(return_object.output)
                return_object.first_number = return_object.output
            return_object.second_number = return_object.operator = ''
            return_object.memory_entry = False
    except ZeroDivisionError:
        return_object.second_number = return_object.operator = return_object.first_number = return_object.output = ''
        return_object.enter_value.set('Undefined')


def dot_check(dot_value, next_value):
    if not dot_value:
        entry_value = '0.'
    else:
        entry_value = dot_value + next_value
    return entry_value


def widget_operation(item_calc, entry, cont=''):
    if entry in '0123456789':
        if not item_calc.operator:
            item_calc.enter_value.set(item_calc.enter_value.get() + entry)
            item_calc.first_number = item_calc.enter_value.get()
            item_calc.state = 1
        else:
            if item_calc.enter_value.get() in '+-*/%':
                item_calc.enter_value.set(entry)
            else:
                item_calc.enter_value.set(item_calc.enter_value.get() + entry)
            item_calc.second_number = item_calc.enter_value.get()
            item_calc.state = 2
    elif entry in '+-*/%':
        item_calc.enter_value.set(entry)
        item_calc.operator = item_calc.enter_value.get()
    elif entry == '.':
        entry_value = item_calc.enter_value.get()
        if not item_calc.operator and not item_calc.second_number:
            if entry not in str(item_calc.first_number):
                item_calc.first_number = dot_check(entry_value, entry)
                item_calc.enter_value.set(item_calc.first_number)
                item_calc.state = 1
        elif item_calc.operator and item_calc.first_number != '':
            if entry not in str(item_calc.second_number):
                if entry_value in '+-*/%': entry_value = ''
                item_calc.second_number = dot_check(entry_value, entry)
                item_calc.enter_value.set(item_calc.second_number)
                item_calc.state = 2
    elif entry == '=' or entry == 'Return':
        return_equals(item_calc, cont)
    elif entry == 'M':
        item_calc.memory = item_calc.output
    elif entry == 'MR':
        if item_calc.memory != '':
            item_calc.enter_value.set(item_calc.memory)
            if item_calc.operator:
                item_calc.second_number = item_calc.memory
                item_calc.state = 2
            else:
                item_calc.first_number = item_calc.memory
                item_calc.state = 1
            item_calc.memory_entry =True
    elif entry == 'MD':
        item_calc.memory = ''
    elif entry == 'C':
        item_calc.enter_value.set('')
        item_calc.first_number = item_calc.second_number = item_calc.operator = item_calc.output = ''
        item_calc.state = 0
        item_calc.memory_entry = False
    elif entry == "⌫":
        value = str(item_calc.enter_value.get())
        if value in '+-*/%':
            pass
        elif (value == str(item_calc.output) and item_calc.operator == '') or value == 'Undefined':
            pass
        elif ('.' in value and item_calc.output != '' and value == str(round(float(item_calc.output),2)) and item_calc.operator == ''):
            pass
        else:
            entry = str(item_calc.enter_value.get())[:-1]
            item_calc.enter_value.set(entry)
            if item_calc.state == 1: item_calc.first_number = entry
            else: item_calc.second_number = entry
    elif entry == "HV":
        if item_calc.open_hv == False:
            item_calc.open_hv = True
            tkinter_csv.history_view(item_calc)
    elif entry == "HF":
        tkinter_csv.spreadsheet_open()


class CalculatorApp:
    def __init__(self, main_root):
        self.first_number = ''
        self.operator = ''
        self.second_number = ''
        self.output = ''
        self.memory = ''
        self.history = []
        self.enter_value = tk.StringVar(master=main_root)
        self.open_hv = False
        self.state = 0
        self.memory_entry = False
        self.main_root = main_root

    def clicked_press(self, event_press):
        if event_press.isdigit() and self.enter_value.get() == '0':
            if event_press == '0':
                return
            self.enter_value.set('')
        else:
            if event_press in '+-*/%' and self.output and self.second_number and self.operator:
                return_equals(self, 'c')
            elif (event_press in '+-*/%=' or event_press == "Return") and self.second_number and self.operator:
                    return_equals(self)
            elif (self.enter_value.get() == 'Undefined' or (self.second_number == '' and not self.operator and self.output != '')) and \
                    (event_press in {'1','2','3','4','5','6','7','8','9','0'} or event_press == '.'):
                self.enter_value.set('')
                self.first_number = ''
                self.output = ''
                self.state = 0
            elif self.memory_entry == True and (event_press in '0123456789' or event_press == '.'):
                self.enter_value.set('')
                if self.operator:
                    self.second_number = ''
                else:
                    self.first_number = ''
                self.memory_entry = False
            elif self.memory_entry and event_press in '+-*/%':
                self.memory_entry = False
        widget_operation(self, event_press)

    def press_key(self, event):
        if event.keysym == "BackSpace":
            widget_operation(self, "⌫")
        elif event.keysym == "Shift_R" or event.keysym == "Shift_L":
            pass
        elif event.keysym == "Return":
            self.clicked_press(event.keysym)
        elif event.char:
            self.clicked_press(event.char)

    def create_window(self):
        button_structure = {
            1: ("M", "MR", "MD", "C"),
            2: (7, 8, 9, "⌫"),
            3: (4, 5, 6, "+"),
            4: (1, 2, 3, "-"),
            5: (".", 0, "=","*"),
            6: ("HV","HF", "%", "/")
        }
        number_entry = tk.Entry(self.main_root, font=15, justify="right", textvariable=self.enter_value,
                                readonlybackground="grey", fg="white", state="readonly")
        number_entry.grid(row=0, column=0, columnspan=4, ipady=12, sticky="ew")
        number_entry.focus_set()
        for column in range(4):
            self.main_root.grid_columnconfigure(column, weight=1, uniform="buttons")
        for key, values in button_structure.items():
            for index, value in enumerate(values):
                button = tk.Button(self.main_root, text=f'{value}', name=f'{key}{index}',bg="#333333",relief="flat",
                                bd=3, fg="white", highlightthickness=2,activebackground="grey", activeforeground="#181818")
                button.grid(row=key,column=index, padx=2, pady=2, ipady=5, sticky="ew")
                button.configure(command=lambda press=value: self.clicked_press(str(press)))
        number_entry.bind("<KeyPress>", self.press_key)
        number_entry.bind("<Return>", self.press_key)
        number_entry.bind("<BackSpace>", self.press_key)


def main():
    root = tk.Tk()
    root.title("A Calculator")
    root.geometry("230x315")
    root.resizable(False, False)
    root.configure(bg="#181818")
    tk_user = CalculatorApp(root)
    tk_user.create_window()
    root.mainloop()


if __name__ == "__main__":
    main()
