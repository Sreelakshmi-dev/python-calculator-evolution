import os
from tkinter import filedialog
import tkinter as tk
import csv
import datetime


def history_view(view_obj):
    root_h = tk.Tk()
    root_h.title("Calc History")
    root_h.geometry("200x200")
    root_h.resizable(False, False)
    root_h.attributes("-toolwindow", True)
    if view_obj.history:
        history = tk.StringVar(root_h, value=view_obj.history)
    else:
        history = ""
    list_box = tk.Listbox(root_h)
    list_box.pack(ipadx=25, ipady=15)
    list_box.configure(listvariable=history)

    def hv_close():
        view_obj.open_hv = False
        root_h.destroy()
    root_h.protocol("WM_DELETE_WINDOW", hv_close)
    root_h.mainloop()


def spreadsheet_open():

    path = filedialog.askopenfilename(title="Choose a type",
                                      filetypes=[
                                          ("CSV Files", "*.csv"),
                                          ("Excel Files", "*.xlsx")
                                      ])
    if path:
        os.startfile(path)


def csvfile_save(f_number, symbol, s_number, output):
    try:
        with open('calculator_history_oops.csv', 'a', newline='', encoding='utf-8') as file_object:
            writer_object = csv.writer(file_object, delimiter=',')
            writer_object.writerow([datetime.date.today(), f_number, symbol, s_number, output])
    except OSError as error:
        print(f'Calculation completed, but CSV saving failed: {error}')
