def option_accept(choice, obj_name):
    if choice == 1:
        return obj_name.addition()
    elif choice == 2:
        return obj_name.subtraction()
    elif choice == 3:
        return obj_name.multiplication()
    elif choice == 4:
        return obj_name.division()
    elif choice == 5:
        return obj_name.floor_division()
    else:
        return obj_name.modulo()


class CalculatorCLI:
    def __init__(self, phrase, memory, history):
        self.phrase = phrase
        self.memory = memory
        self.history = history

    def begin_calculator(self):
        print(self.phrase)
        result = None
        cont = ''
        while True:
            try:
                option = int(input("Enter your choice: "))
                if option in [1, 2, 3, 4, 5, 6]:
                    if cont != 'c':
                        first_number = int(input('Enter first number: '))
                    second_number = int(input('Enter second number: '))
                    calc_obj = CL.Calculator(first_number, second_number)
                    result = option_accept(option, calc_obj)
                    print(f'{first_number} {OPERATIONS[option][1]} {second_number} = {result}')
                    vs.history_save(self.history, OPERATIONS[option][1], first_number, second_number, result)
                    vs.csvfile_save(first_number, OPERATIONS[option][1], second_number, result)
                    cont = input("Enter c if you want to use Calculator chain: ").strip().lower()
                    if cont == 'c':
                        first_number = result
                elif option in [7, 8, 9]:
                    m.memory_manage(result, self.memory, option)
                elif option == 10:
                    vs.history_view(self.history)
                elif option == 11:
                    vs.csvfile_view()
                elif option == 12:
                    break
                else:
                    raise ValueError

            except ValueError:
                print("Invalid Input...")
            except TypeError:
                print("Values not available")
            except ZeroDivisionError:
                print("Division and Modulo by 0 is not allowed...")


def main():
    calc_memory = []
    calc_history = []
    OP.menu()
    user = CalculatorCLI("A Calculator using OOPs...", calc_memory, calc_history)
    user.begin_calculator()
    print("Finished")


if __name__ == '__main__':
    main()

